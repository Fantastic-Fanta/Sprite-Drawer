# models/<pokemon>/ is tracked for its configs and model-prep scripts only. Everything else in it
# stays local: the ripped model and textures (not ours to redistribute), references, prep output,
# scratch, working notes
models/*/*/
*.blend
*.blend1
*.dae
*.fbx
*.obj
*.mtl
*.glb
*.png
!sprites/overview.png
models/*/_*.json
models/*/*.v[0-9]*.*
models/*/gen*.py
models/*/fix_shiny.py
models/*/*.md
models/*/motion.note
models/mega-greninja-za/

# build output, render cache, regression data, Blender slot locks
out/
.render_cache/
.regress/
.blender_slots/

# tool clutter
__pycache__/
*.pyc
.DS_Store
.claude/
*.patch
model-links.md
