  "motion": {
    "frames": 96,
    "note": "Mega Skarmory is a steel bird in flight (HOME render and Z-A art: airborne, body pitched forward, bladed wings raised in a V, legs and toe blades trailing): the wingbeat is the driver. Two beats per loop (1.44 s each): a big eased down-stroke (~57% of the beat, shoulder from ~60 deg above level to ~25 below, sweeping forward and pronating so the blade faces show), then a quicker folding up-stroke (wing sweeps back, blade fan closes, tips droop). The body rises on the down-stroke and sinks on the up-stroke, pitching a little; the head counter-nods so the face stays steady and readable; blade joints, crest, legs, toe blades and tail each lag a step further behind.",
    "functions": {
      "pw": "CYC*t - WARP*(1 - cos(2*pi*CYC*t))/(2*pi)",
      "wd": "cos(2*pi*pw(t))",
      "fd": "(0.5 + 0.5*cos(2*pi*(pw(t) - 0.78)))**2"
    }
  },
